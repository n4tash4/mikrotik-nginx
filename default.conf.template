# nginx vhost template for the Home Assistant reverse proxy.
#
# nginx.sh renders this to /etc/nginx/conf.d/default.conf with envsubst,
# substituting ONLY ${DOMAIN} and ${UPSTREAM} so nginx's own runtime variables
# ($host, $scheme, $http_upgrade, $remote_addr, $proxy_add_x_forwarded_for,
# $connection_upgrade, $request_uri) survive untouched. The Debian default site
# is removed by nginx.sh before this is loaded.
#
# $connection_upgrade comes from the map in 00-upgrade-map.conf (http context).

# ---------------------------------------------------------------------------
# :80 — plain HTTP. Certificates are obtained via DNS-01 (certbot-dns-route53),
# so there is NO HTTP-01 webroot challenge to serve here. This server exists
# only to 302-redirect every request to HTTPS.
# ---------------------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    # Permanent-ish redirect to HTTPS, preserving host and path.
    return 302 https://$host$request_uri;
}

# ---------------------------------------------------------------------------
# :443 — TLS termination + reverse proxy to Home Assistant.
# ---------------------------------------------------------------------------
server {
    # nginx 1.22 (Debian bookworm) uses the per-listen "http2" form, not the
    # 1.25+ standalone "http2 on;" directive.
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${DOMAIN};

    # Certs live under the persisted /etc/letsencrypt mount (see the .rsc).
    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache   shared:SSL:10m;

    location / {
        proxy_pass ${UPSTREAM};

        # HTTP/1.1 + the WebSocket upgrade headers are MANDATORY for Home
        # Assistant — the frontend keeps a WebSocket open and breaks without
        # these. $connection_upgrade is driven by the map (00-upgrade-map.conf).
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Pass through the real client/scheme so HA sees the external request.
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Long-lived WebSocket connections — keep the upstream read open.
        proxy_read_timeout 90s;
    }
}
